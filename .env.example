# Database Configuration
DATABASE_URL=sqlite:///./sap_inventory.db
# For PostgreSQL: postgresql://postgres:postgrespassword@localhost:5432/sap_inventory

# SAP Integration Settings
SAP_MODE=mock
SAP_BASE_URL=https://sap-s4hana.internal:50000
SAP_CLIENT=100
SAP_USERNAME=SAP_INT_USER
SAP_PASSWORD=your_sap_password_here
SAP_API_PATH=/sap/opu/odata/sap/ZINVENTORY_SRV
SAP_TIMEOUT=30

# Optional Groq LLM API Key
GROQ_API_KEY=

# Security & CORS
CORS_ORIGINS=*
